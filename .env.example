# ==============================================================================
# Balaji Transports Workforce Management — Production Environment Variables
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Core Flask & Security
# Generate a cryptographically strong 64-character secret:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-key-in-production
FLASK_ENV=production
FLASK_DEBUG=0
STRICT_PRODUCTION_SECRETS=1

# Host and Port binding (WSGI servers like Gunicorn / Waitress)
PORT=5000
HOST=0.0.0.0

# Reverse Proxy (ProxyFix) Settings
# Enable when deployed behind Nginx, Render, Cloudflare, or AWS ALB (1 = enabled, 0 = disabled)
# ProxyFix ensures request.remote_addr, scheme (https), and port reflect the client connection
ENABLE_PROXY_FIX=1
PROXY_FIX_FOR=1
PROXY_FIX_PROTO=1
PROXY_FIX_HOST=1

# Database Persistence Path
# Local SQLite default: sqlite:///instance/balaji_workforce.sqlite3
# Production PostgreSQL (Render / Supabase / AWS): postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///instance/balaji_workforce.sqlite3

# PostgreSQL Connection Pool Tuning (Only used when DATABASE_URL is PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# Approved Workplace Geofence Configuration
# Latitude and longitude of the primary facility:
GEOFENCE_LATITUDE=13.3698889
GEOFENCE_LONGITUDE=77.1190278
# Permitted attendance radius in meters:
GEOFENCE_RADIUS_METERS=200
# Maximum acceptable browser GPS uncertainty (accuracy circle radius in meters):
GEOFENCE_MAX_ACCURACY_METERS=500

# Session & Cookie Security (1 = HTTPS only, 0 = Allow HTTP for local testing)
# In production with HTTPS, always keep this set to 1.
SESSION_COOKIE_SECURE=1

# Optional: Path to custom Android APK file for workforce direct download
# APK_PATH=E:/Balaji_Workforce_System/Balaji_Workforce.apk
