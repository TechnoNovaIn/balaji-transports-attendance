# Balaji Transports — Environment Variables
# Copy to .env and set values for local development.
# On Render, set these in the Dashboard > Environment tab.

SECRET_KEY=replace-with-a-long-random-secret
# DATABASE_URL=sqlite:///instance/balaji_workforce.sqlite3
# DATABASE_URL=postgresql://user:pass@host:5432/balaji_workforce
# PORT=5000
# HOST=127.0.0.1
# FLASK_DEBUG=0

# Set to 1 in production behind HTTPS
# SESSION_COOKIE_SECURE=1

# Factory geofence (defaults are hardcoded; override via env vars)
# GEOFENCE_LATITUDE=13.3698889
# GEOFENCE_LONGITUDE=77.1190278
# GEOFENCE_RADIUS_METERS=200
